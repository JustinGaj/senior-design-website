{
  "name": "gimbaled-drone-project-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/http-smoke.mjs",
    "db:init": "node --env-file-if-exists=.env.local scripts/database.mjs init",
    "db:backup": "node --env-file-if-exists=.env.local scripts/database.mjs backup",
    "db:check": "node --env-file-if-exists=.env.local scripts/database.mjs check",
    "admin:create": "node --env-file-if-exists=.env.local scripts/admin.mjs create",
    "admin:reset-password": "node --env-file-if-exists=.env.local scripts/admin.mjs reset",
    "admin:revoke-sessions": "node --env-file-if-exists=.env.local scripts/admin.mjs revoke"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.5.0"
  }
}
