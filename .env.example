# Node 24.13+; copy this file to .env.local for local development.
# In production, use your process manager's environment and an absolute persistent path.
DATABASE_PATH=./data/site.sqlite
DATABASE_BACKUP_DIR=./data/backups
APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Leave blank to disable automated publishing until n8n is configured.
UPDATES_INGEST_TOKEN=
